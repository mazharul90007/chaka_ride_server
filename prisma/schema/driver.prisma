model Driver {
  id            String     @id @default(uuid())
  phone         String?
  licenseNumber String?
  vehicleType   String?
  vehicleModel  String?
  vehicleNumber String?
  userId        String     @unique
  status        UserStatus @default(PENDING)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver")
}
