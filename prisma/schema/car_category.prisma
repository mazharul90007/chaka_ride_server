model CarCategory {
  id             String   @id @default(uuid())
  categoryName   String
  description    String
  seat           String
  luggage        String
  ac             String
  fuel           String
  features       Json
  categoryIcon   String?
  photos         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  acBn           String?
  categoryNameBn String?
  descriptionBn  String?
  fuelBn         String?
  luggageBn      String?
  seatBn         String?
  cars           Car[]
  drivers        Driver[]
  queries        Query[]

  @@map("car_category")
}
