model Query {
  id             String      @id @default(uuid())
  fullName       String
  whatsAppNumber String
  pickupLocation String
  destination    String
  tripType       TripType    @default(ONE_WAY)
  pickupDate     String
  pickupTime     String
  status         QueryStatus @default(PENDING)
  userId         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  email          String
  carCategoryId  String
  carCategory    CarCategory @relation(fields: [carCategoryId], references: [id])
  user           User?       @relation("UserQueries", fields: [userId], references: [id])

  @@map("query")
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum QueryStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}
